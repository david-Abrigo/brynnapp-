<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- Header: Modern Matte Black Hero Box -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_header_bg"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Store Name & Yape Count Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_store_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:letterSpacing="0.06"
                android:maxLines="1"
                android:text="MI NEGOCIO • HOY"
                android:textColor="#A1A1AA"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_tx_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_badge_bg"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:text="0 yapes"
                android:textColor="#121212"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Big Amount Display -->
        <TextView
            android:id="@+id/widget_total_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="S/ 0.00"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Total Recaudado Hoy"
            android:textColor="#71717A"
            android:textSize="10sp"
            android:textStyle="normal" />
    </LinearLayout>

    <!-- Subtitle Bar & Section Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:letterSpacing="0.04"
            android:text="MOVIMIENTOS DE HOY"
            android:textColor="#555861"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_refresh_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Actualizar"
            android:textColor="#787B86"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Safe Divider using FrameLayout (RemoteViews whitelisted) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="4dp"
        android:background="#EBECEF" />

    <!-- Container for List and Empty View -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- List of today's transactions -->
        <ListView
            android:id="@+id/widget_transactions_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="#F3F4F7"
            android:dividerHeight="1dp" />

        <!-- Empty view when no payments yet -->
        <LinearLayout
            android:id="@+id/widget_empty_text"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Sin pagos registrados hoy"
                android:textColor="#111111"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:text="Toca para abrir la aplicación"
                android:textColor="#787B86"
                android:textSize="11sp" />
        </LinearLayout>
    </FrameLayout>

</LinearLayout>
